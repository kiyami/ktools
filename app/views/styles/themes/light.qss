/* ===== BASE ===== */
QWidget {
    background-color: #f6f7fb;
    color: #1e1e1e;
    font-family: "Arial", "Roboto", sans-serif;
    font-size: 13px;
}

/* ===== BUTTON ===== */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    padding: 6px 10px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #f0f0f0;
}

QPushButton:pressed {
    background-color: #e6e6e6;
}

/* ===== TABLE ===== */
QTableView {
    background-color: white;
    gridline-color: #e6e6e6;
    border: 1px solid #ddd;
    alternate-background-color: #fafafa;
}

QHeaderView::section {
    background-color: #f2f2f2;
    border: none;
    padding: 4px;
}

/* ===== LIST ===== */
QListWidget {
    background-color: white;
    border: 1px solid #ddd;
}

/* ===== INPUTS ===== */
QLineEdit, QTextEdit {
    background-color: white;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 4px;
}

QLabel#dropArea {
    border: 2px dashed #888;
    border-radius: 8px;
    color: #666;
    padding: 6px;
    background-color: transparent;
}

/* =========================
   LIGHT THEME - TOOLBAR
   ========================= */

QToolBar {
    background-color: #f6f7fb;
    border-bottom: 1px solid #e3e6ee;
    padding: 6px;
    spacing: 6px;
}

/* =========================
   TOOLBUTTON
   ========================= */

QToolButton {
    background-color: #e9ebf0;
    border: none;
    color: #1e1e1e;
    padding: 4px;
    border-radius: 6px;
}

QToolButton:hover {
    background-color: #e9ebf0;
}

QToolButton:pressed {
    background-color: #dfe3ea;
}

QToolButton:checked {
    background-color: #d6dbe6;
}

/* =========================
   CONSOLE - LIGHT
   ========================= */

QPlainTextEdit#consoleView {
    background-color: #eef2f7;

    border: 1px solid #d8dce5;
    border-radius: 8px;

    padding: 2px;

    color: #222222;

    selection-background-color: #d6dbe6;
    selection-color: #111111;
}