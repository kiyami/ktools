/* =========================
   GLOBAL
========================= */
QWidget {
    background-color: #f7f8fa;
    color: #1f2328;
    font-family: "Arial", "Roboto", sans-serif;
    font-size: 13px;
}

/* =========================
   GENERAL SURFACE (cards / panels)
========================= */
QWidget#canvasContainer,
QWidget#tableContainer {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
}

/* =========================
   BUTTON BASE
========================= */
QPushButton {
    background-color: #f3f4f6;
    border: 1px solid #d0d7de;
    padding: 6px 12px;
    border-radius: 8px;
}

QPushButton:hover {
    background-color: #eaeef2;
    border: 1px solid #c9d1d9;
}

QPushButton:pressed {
    background-color: #dce3ea;
}

/* =========================
   PRIMARY BUTTON
========================= */
QPushButton[variant="primary"] {
    background-color: #2f6feb;
    color: white;
    border: none;
}

QPushButton[variant="primary"]:hover {
    background-color: #1f5bd6;
}

QPushButton[variant="primary"]:pressed {
    background-color: #1a4fb8;
}

/* =========================
   DANGER BUTTON
========================= */
QPushButton[variant="danger"] {
    background-color: #cf222e;
    color: white;
    border: none;
}

QPushButton[variant="danger"]:hover {
    background-color: #b81d27;
}

/* =========================
   COMBOBOX
========================= */
QComboBox {
    background-color: white;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 4px 8px;
}

QComboBox:hover {
    border: 1px solid #2f6feb;
}

QComboBox QAbstractItemView {
    background-color: white;
    selection-background-color: #dbe9ff;
    selection-color: #1f2328;
}

/* =========================
   TABLE (Excel feel)
========================= */
QTableView {
    background-color: white;
    border: 1px solid #e1e4e8;
    gridline-color: #f0f2f5;
    selection-background-color: #dbe9ff;
    selection-color: #1f2328;
}

QHeaderView::section {
    background-color: #f6f8fa;
    border: 1px solid #e1e4e8;
    padding: 6px;
    font-weight: 600;
}

/* =========================
   LIST (Plot list)
========================= */
QListWidget {
    background-color: white;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
}

QListWidget::item {
    padding: 6px;
}

QListWidget::item:selected {
    background-color: #dbe9ff;
    color: #1f2328;
}

/* =========================
   LINE EDIT
========================= */
QLineEdit {
    background-color: white;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 5px 8px;
}

QLineEdit:focus {
    border: 1px solid #2f6feb;
}