/* =====================================================
   LIGHT THEME
   ===================================================== */

/* ── Base ── */
QWidget {
    background-color: #f6f7fb;
    color: #1e1e1e;
    font-family: "Arial", "Roboto", sans-serif;
    font-size: 13px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 5px 10px;
}
QPushButton:hover   { background-color: #f0f0f0; }
QPushButton:pressed { background-color: #e2e2e2; }
QPushButton:disabled { color: #aaaaaa; }

/* ── Toolbar ── */
QToolBar {
    background-color: #f6f7fb;
    border-bottom: 1px solid #e0e0e0;
    padding: 3px;
    spacing: 3px;
}
QToolButton {
    background-color: #e9ebf0;
    border: none;
    border-radius: 6px;
    color: #1e1e1e;
    padding: 4px 8px;
}
QToolButton:hover   { background-color: #dde0e8; }
QToolButton:pressed { background-color: #d2d6de; }
QToolButton:checked { background-color: #c8cdd8; }

/* ── Inputs ── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 3px 6px;
    color: #1e1e1e;
}
QLineEdit:focus, QTextEdit:focus {
    border-color: #7aafff;
}

/* ── ComboBox ── */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 3px 6px;
    min-height: 22px;
}
QComboBox:disabled { color: #aaaaaa; }

/* ── SpinBox ── */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 3px 6px;
}

/* ── Table ── */
QTableView {
    background-color: #ffffff;
    gridline-color: #e6e6e6;
    border: 1px solid #dddddd;
    alternate-background-color: #fafafa;
}
QHeaderView::section {
    background-color: #f2f2f2;
    border: none;
    padding: 4px;
    font-weight: bold;
}

/* ── List ── */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 4px;
}
QListWidget::item:selected {
    background-color: #d6e4ff;
    color: #1e1e1e;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #e0e0e0;
    width: 2px;
    height: 2px;
}
QSplitter::handle:hover { background-color: #b0b0b0; }

/* ── Labels ── */
QLabel {
    min-height: 22px;
    background-color: transparent;
}
QLabel:disabled { color: #aaaaaa; }

/* ── GroupBox ── */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 8px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
}

/* ── ScrollArea ── */
QScrollArea { border: none; }

/* ── Console (named widget) ── */
QPlainTextEdit#consoleView {
    background-color: #eef2f7;
    border: 1px solid #d0d6e0;
    border-radius: 6px;
    color: #222222;
    font-family: "Menlo", "Consolas", monospace;
    font-size: 12px;
}

/* ── Drop area (named label) ── */
QLabel#dropArea {
    border: 2px dashed #aaaaaa;
    border-radius: 8px;
    color: #666666;
    background-color: transparent;
}
