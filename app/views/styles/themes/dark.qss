/* ===== BASE ===== */
QWidget {
    background-color: #1e1f22;
    color: #e6e6e6;
    font-family: "Arial", "Roboto", sans-serif;
    font-size: 13px;
}

/* ===== BUTTON ===== */
QPushButton {
    background-color: #2a2d31;
    border: 1px solid #3a3d42;
    padding: 6px 10px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #34373d;
}

QPushButton:pressed {
    background-color: #3d4046;
}

/* ===== TABLE ===== */
QTableView {
    background-color: #232427;
    gridline-color: #2f3237;
    border: 1px solid #3a3d42;
    alternate-background-color: #26282d;
}

QHeaderView::section {
    background-color: #2a2d31;
    border: none;
    padding: 4px;
}

/* ===== LIST ===== */
QListWidget {
    background-color: #232427;
    border: 1px solid #3a3d42;
}

/* ===== INPUTS ===== */
QLineEdit, QTextEdit {
    background-color: #2a2d31;
    border: 1px solid #3a3d42;
    border-radius: 6px;
    padding: 4px;
    color: #e6e6e6;
}

QLabel#dropArea {
    border: 2px dashed #555;
    border-radius: 8px;
    color: #aaa;
    padding: 6px;
    background-color: transparent;
}

/* =========================
   LIGHT THEME - TOOLBAR
   ========================= */

QToolBar {
    background-color: #1b1c1f;
    border-bottom: 1px solid #2a2d31;
    padding: 6px;
}

/* =========================
   TOOLBUTTON
   ========================= */

QToolButton {
    background-color: transparent;
    border: none;
    color: #e6e6e6;
    padding: 4px;
}

QToolButton:hover {
    background-color: #2f3237;
    border-radius: 6px;
}

QToolButton:pressed {
    background-color: #3a3d42;
}

QToolButton:checked {
    background-color: #40444b;
    border-radius: 6px;
}
