
/* =========================
   GLOBAL
========================= */
QWidget {
    background-color: #0f1117;
    color: #e6edf3;
    font-family: "Arial", "Roboto", sans-serif;
    font-size: 13px;
}

/* =========================
   PANELS / CARDS
========================= */
QWidget#canvasContainer,
QWidget#tableContainer {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
}

/* =========================
   BUTTON BASE
========================= */
QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    padding: 6px 12px;
    border-radius: 8px;
    color: #e6edf3;
}

QPushButton:hover {
    background-color: #30363d;
    border: 1px solid #484f58;
}

QPushButton:pressed {
    background-color: #1a1f24;
}

/* =========================
   PRIMARY BUTTON
========================= */
QPushButton[variant="primary"] {
    background-color: #2f81f7;
    border: none;
    color: white;
}

QPushButton[variant="primary"]:hover {
    background-color: #1f6feb;
}

QPushButton[variant="primary"]:pressed {
    background-color: #1a5fd0;
}

/* =========================
   DANGER BUTTON
========================= */
QPushButton[variant="danger"] {
    background-color: #da3633;
    border: none;
    color: white;
}

QPushButton[variant="danger"]:hover {
    background-color: #b62324;
}

/* =========================
   COMBOBOX
========================= */
QComboBox {
    background-color: #0f1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px 8px;
    color: #e6edf3;
}

QComboBox:hover {
    border: 1px solid #2f81f7;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    selection-background-color: #1f6feb;
    selection-color: white;
}

/* =========================
   TABLE (Excel dark mode)
========================= */
QTableView {
    background-color: #0f1117;
    border: 1px solid #30363d;
    gridline-color: #1f242b;
    selection-background-color: #1f6feb;
    selection-color: white;
}

QHeaderView::section {
    background-color: #161b22;
    border: 1px solid #30363d;
    padding: 6px;
    font-weight: 600;
    color: #e6edf3;
}

/* =========================
   LIST (plot list)
========================= */
QListWidget {
    background-color: #0f1117;
    border: 1px solid #30363d;
    border-radius: 8px;
}

QListWidget::item {
    padding: 6px;
    color: #e6edf3;
}

QListWidget::item:selected {
    background-color: #1f6feb;
    color: white;
}

/* =========================
   LINE EDIT
========================= */
QLineEdit {
    background-color: #0f1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 5px 8px;
    color: #e6edf3;
}

QLineEdit:focus {
    border: 1px solid #2f81f7;
}